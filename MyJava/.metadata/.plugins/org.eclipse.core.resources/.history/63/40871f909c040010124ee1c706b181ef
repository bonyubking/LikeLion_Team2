package com.workshop11.num01;

public class Car extends Vehicle {
	
	private double restOil;
	private int curWeight;

	public double getRestOil() {
		return restOil;
	}

	public void setRestOil(double restOil) {
		this.restOil = restOil;
	}

	public int getCurWeight() {
		return curWeight;
	}

	public void setCurWeight(int curWeight) {
		this.curWeight = curWeight;
	}

	public Car() {

	}

	public Car(int maxWeight, double oilTankSize, double efficiency) {
		super(maxWeight, oilTankSize, efficiency);

	}
	
	public void addOil(int oil) {
		if (restOil + oil > this.getOilTankSize()) {
			restOil = this.getOilTankSize();  
		} else {
			restOil += oil;
		}
	}
	
	public void moving(int distance) {
		restOil -= distance / this.getEfficiency();
		if (restOil < 0) {
			restOil = 0;
		}
	}
	
	public void addWeight(int weight) {
		if (curWeight + weight > this.getMaxWeight()) {
			curWeight = this.getMaxWeight();  
		} else {
			curWeight += weight;
		}
	}
	
	@Override
	public String toString() {
		return String.format("%d %.1f %.1f %d", this.getMaxWeight() , this.getOilTankSize(), restOil, curWeight);
	}
	
}
