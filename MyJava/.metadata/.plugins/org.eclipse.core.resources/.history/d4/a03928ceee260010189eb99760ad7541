package com.typing.dao.Post;

import java.sql.SQLException;
import java.util.List;

import com.typing.model.dto.PostDTO;

public interface PostDAO {

    // 게시글 목록을 시간순으로 가져오기
    List<PostDTO> getPostsByTime() throws SQLException;

    // 게시글 ID로 게시글 가져오기
    PostDTO getPostById(int postId) throws SQLException;

    // 게시글 작성
    void createPost(PostDTO postDTO) throws SQLException;

    // 게시글 수정
    void updatePost(PostDTO postDTO) throws SQLException;

    // 게시글 삭제
    void deletePost(int postId) throws SQLException;
}
