package com.sec12.labmbda;


public class LambdaTest {
	
	interface Fun01{
		public String prn(String name);
	}

	interface Fun02{
		public String prn02();
	}
	
	interface Fun03{
		public void say(String name);
	}

	public static void main(String[] args) {
		Fun01 m_name = name-> "hello!" + name;
		System.out.println("m_name:" + m_name.prn("bon"));
		
		Fun02 m_test = () -> "테스트 ";
		System.out.println(m_test.prn02());
		
		Fun03 m_test03 = (name) -> System.out.println("hello "+name);
		m_test03.say("정길동");
				
 
	}

}
