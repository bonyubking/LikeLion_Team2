import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class PostDAOImpl implements PostDAO {

    private Connection conn;

    public PostDAOImpl(Connection conn) {
        this.conn = conn;
    }

    @Override
    public List<PostDTO> getPostsByTime() throws SQLException {
        List<PostDTO> postList = new ArrayList<>();
        String sql = "SELECT post_id, title, content, created_at FROM Posts ORDER BY created_at DESC";

        try (Statement stmt = conn.createStatement(); ResultSet rs = stmt.executeQuery(sql)) {
            while (rs.next()) {
                PostDTO postDTO = new PostDTO(
                        rs.getInt("post_id"),
                        rs.getString("title"),
                        rs.getString("content"),
                        rs.getTimestamp("created_at")
                );
                postList.add(postDTO);
            }
        }

        return postList;
    }

    @Override
    public PostDTO getPostById(int postId) throws SQLException {
        String sql = "SELECT post_id, title, content, created_at FROM Posts WHERE post_id = ?";
        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setInt(1, postId);
            ResultSet rs = stmt.executeQuery();
            if (rs.next()) {
                return new PostDTO(
                        rs.getInt("post_id"),
                        rs.getString("title"),
                        rs.getString("content"),
                        rs.getTimestamp("created_at")
                );
            }
        }
        return null;
    }

    @Override
    public void createPost(PostDTO postDTO) throws SQLException {
        String sql = "INSERT INTO Posts (user_id, title, content, created_at) VALUES (?, ?, ?, ?)";
        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setInt(1, postDTO.getUserId());
            stmt.setString(2, postDTO.getTitle());
            stmt.setString(3, postDTO.getContent());
            stmt.setTimestamp(4, new Timestamp(System.currentTimeMillis()));
            stmt.executeUpdate();
        }
    }

    @Override
    public void updatePost(PostDTO postDTO) throws SQLException {
        String sql = "UPDATE Posts SET title = ?, content = ? WHERE post_id = ?";
        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setString(1, postDTO.getTitle());
            stmt.setString(2, postDTO.getContent());
            stmt.setInt(3, postDTO.getPostId());
            stmt.executeUpdate();
        }
    }

    @Override
    public void deletePost(int postId) throws SQLException {
        String sql = "DELETE FROM Posts WHERE post_id = ?";
        try (PreparedStatement stmt = conn.prepareStatement(sql)) {
            stmt.setInt(1, postId);
            stmt.executeUpdate();
        }
    }
}
